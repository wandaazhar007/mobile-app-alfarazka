# Salin ke .env, isi dari docs/SECRETS.md (sama Firebase project dengan frontend/).
# WAJIB prefix EXPO_PUBLIC_ supaya ke-embed di client bundle.
EXPO_PUBLIC_API_BASE_URL=https://api-app.alfarazkabakery.com
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Android saja (iOS pakai Apple Maps bawaan, tidak perlu key) — dari Google Cloud
# Console, project dengan "Maps SDK for Android" aktif. TANPA prefix EXPO_PUBLIC_
# karena cuma dibaca app.config.ts saat build, tidak perlu ikut ke JS bundle client.
GOOGLE_MAPS_ANDROID_API_KEY=
